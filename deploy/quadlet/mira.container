# Rootless Podman Quadlet for Bazzite / Fedora Atomic. No rpm-ostree layering needed.
#
# One-time setup (as your normal user):
#   podman build -t mira-server -f Containerfile .
#   printf '%s' 'your-household-password' | podman secret create mira-password -
#   mkdir -p ~/.config/containers/systemd && cp deploy/quadlet/mira.container ~/.config/containers/systemd/
#   systemctl --user daemon-reload && systemctl --user start mira
#   loginctl enable-linger "$USER"        # keep it running when you're logged out / after reboot
#   sudo firewall-cmd --permanent --add-port=8787/tcp && sudo firewall-cmd --reload
#
# Update after pulling new code: rebuild the image, then `systemctl --user restart mira`
# (or `podman auto-update`, which restarts it when the local image changed).

[Unit]
Description=Mira household grocery sync server
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=mira
Image=localhost/mira-server:latest
PublishPort=8787:8787
Volume=mira-data:/data:Z
Secret=mira-password,type=env,target=MIRA_PASSWORD
AutoUpdate=local
HealthCmd=node -e "fetch('http://127.0.0.1:8787/api/health').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"
HealthInterval=30s

[Service]
Restart=always
TimeoutStopSec=30

[Install]
WantedBy=default.target
