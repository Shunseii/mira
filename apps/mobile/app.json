{
  "expo": {
    "name": "Mira",
    "slug": "mira",
    "scheme": "mira",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F5F1E8",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/6bf8fb07-bc8a-4b71-a37d-2ae4e0155270"
    },
    "ios": {
      "bundleIdentifier": "com.shunseii.mira",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Mira syncs your household list with your own server on your home network.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.shunseii.mira",
      "adaptiveIcon": {
        "backgroundColor": "#B4502B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "name": "Mira",
      "shortName": "Mira",
      "themeColor": "#F5F1E8",
      "backgroundColor": "#F5F1E8"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F1E8",
          "dark": {
            "backgroundColor": "#1E1A16"
          },
          "imageWidth": 120,
          "image": "./assets/splash-icon.png"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-quick-actions",
      "expo-localization",
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/noto-naskh-arabic/700Bold/NotoNaskhArabic_700Bold.ttf",
            "./node_modules/@expo-google-fonts/fraunces/500Medium/Fraunces_500Medium.ttf",
            "./node_modules/@expo-google-fonts/instrument-sans/400Regular/InstrumentSans_400Regular.ttf",
            "./node_modules/@expo-google-fonts/instrument-sans/600SemiBold/InstrumentSans_600SemiBold.ttf"
          ],
          "widgets": [
            {
              "name": "GroceryList",
              "label": "Mira list",
              "description": "This month's groceries at a glance",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "500dp",
              "maxResizeHeight": "600dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6bf8fb07-bc8a-4b71-a37d-2ae4e0155270"
      }
    },
    "owner": "shunsei"
  }
}
